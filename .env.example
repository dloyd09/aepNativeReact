# Adobe IMS — OAuth Server-to-Server credentials
# Source: https://developer.adobe.com/console → Your Project → Credentials → OAuth Server-to-Server
AEP_ORG_ID=XXXXXXXXXXXXXXXX@AdobeOrg
AEP_CLIENT_ID=your-client-id
AEP_CLIENT_SECRET=your-client-secret

# AEP sandbox and tenant
AEP_TENANT_ID=adobecmteas
AEP_SANDBOX_NAME=prod

# Optional: user access token to bypass S2S auth for Assurance API.
# Assurance sessions are user-scoped — S2S tokens get FORBIDDEN.
# Generate at: developer.adobe.com/console → your project → OAuth S2S → Generate access token
# Expires in ~24h; leave blank to use S2S (works for Schema Registry, not Assurance sessions).
AEP_ACCESS_TOKEN=

# Streaming inlet ID — required for upsert-profile.js (streaming mode, default)
# Find it: AEP → Sources → HTTP API source → your connection → Streaming endpoint URL (UUID at the end)
AEP_INLET_ID=

# Datastream ID — required for send-edge-event.js
# Find it: AEP Data Collection → Datastreams → your datastream → copy the ID (UUID format)
AEP_DATASTREAM_ID=
